# Which LLM backend powers the "Ask AI" panel: anthropic (default), ollama, lmstudio, or openai.
READER3_PROVIDER=anthropic

# --- anthropic (cloud, needs a key) ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- ollama (local, free, no key) ---
# 1. Install & run: https://ollama.com  →  ollama pull llama3.2  →  ollama serve
# 2. READER3_PROVIDER=ollama
# 3. READER3_MODEL=llama3.2   (or whatever you pulled)

# --- lmstudio (local, free, no key) ---
# 1. Open LM Studio → load a model → start the local server (Developer tab)
# 2. READER3_PROVIDER=lmstudio
# 3. READER3_MODEL=<the model name shown in LM Studio's server tab>

# --- openai / any other OpenAI-compatible endpoint ---
# READER3_PROVIDER=openai
# READER3_API_KEY=
# READER3_MODEL=gpt-4o-mini

# Override the auto-picked default model for the selected provider.
# READER3_MODEL=

# Override the base URL (rarely needed — e.g. LM Studio on a non-default port,
# or Ollama running on another machine on your network).
# READER3_BASE_URL=
